# Runtime database. Recreated on first run, migrating from customers.txt and
# books.txt, so it does not need to travel with the repo.
bookstore.db
bookstore.db-journal
bookstore.db-wal
bookstore.db-shm

# Backups taken before loading sql/sample-data.sql.
bookstore.db.bak-*

# Build output, regenerated by `ant jar`. These were committed originally, so
# every build rewrote tracked .class files and the dist jar and showed up as a
# large diff. Untracked as of this commit; the sources still build them.
build/
dist/

# NetBeans per-machine IDE state: open editor tabs, and the path to the
# local NetBeans build.properties. Regenerated when the project is opened.
nbproject/private/
